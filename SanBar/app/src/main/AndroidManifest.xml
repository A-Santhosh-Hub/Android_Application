<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read the connected headphones' name and battery level. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Only for the optional "Real" visualizer: Android's Visualizer API reads the sound going
        to the speaker/headphones (output mix), not the microphone, but still requires these.
        Asked only when the user picks "Real" in Customize.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- See launchable apps, so the widget can show the playing app's name and open it on tap. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SanBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SanBarWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sanbar_widget_info" />
        </receiver>

        <receiver
            android:name=".StatsWidget"
            android:exported="true"
            android:label="@string/stats_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stats_widget_info" />
        </receiver>

        <!--
            Notification access is what Android requires before an app may read other apps'
            media sessions (song, artist, cover, play/pause). SanBar never reads notifications:
            disabled_filter_types turns every notification type off for this listener.
            Android also keeps a granted listener running, so the widget stays live without a
            foreground "app is running" notification.
        -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="conversations|alerting|ongoing|silent" />
        </service>
    </application>
</manifest>
