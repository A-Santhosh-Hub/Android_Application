<?xml version="1.0" encoding="utf-8"?>
<!--
    2-row card. Same layers as the slim bar:
    RGB effect (fx_layer) → 2dp inset glass (content) → spectrum bars (viz_row) → controls.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root"
    android:clipToOutline="true">

    <include layout="@layout/fx_layer" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/bg_glass">

        <include layout="@layout/viz_bars" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/music_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cover"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cover_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Nothing playing"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/bt_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:drawableStart="@drawable/ic_headphones_small"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/text_dim"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/accent"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/battery_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <ProgressBar
                                android:id="@+id/ring_phone"
                                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:maxWidth="44dp"
                                android:maxHeight="44dp"
                                android:minWidth="44dp"
                                android:minHeight="44dp"
                                android:progress="0"
                                android:progressDrawable="@drawable/ring_progress" />

                            <ProgressBar
                                android:id="@+id/ring_charge"
                                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:indeterminate="true"
                                android:indeterminateBehavior="repeat"
                                android:indeterminateDrawable="@drawable/charge_comet"
                                android:indeterminateDuration="1600"
                                android:interpolator="@android:anim/linear_interpolator"
                                android:maxWidth="44dp"
                                android:maxHeight="44dp"
                                android:visibility="gone" />

                            <ProgressBar
                                android:id="@+id/ring_charge_fast"
                                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:indeterminate="true"
                                android:indeterminateBehavior="repeat"
                                android:indeterminateDrawable="@drawable/charge_comet"
                                android:indeterminateDuration="600"
                                android:interpolator="@android:anim/linear_interpolator"
                                android:maxWidth="44dp"
                                android:maxHeight="44dp"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/icon_phone"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Phone battery"
                                android:src="@drawable/ic_phone"
                                android:tint="@color/text" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/pct_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bt_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <ProgressBar
                                android:id="@+id/ring_bt"
                                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:maxWidth="44dp"
                                android:maxHeight="44dp"
                                android:minWidth="44dp"
                                android:minHeight="44dp"
                                android:progress="0"
                                android:progressDrawable="@drawable/ring_progress" />

                            <ImageView
                                android:id="@+id/icon_bt"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Headphone battery"
                                android:src="@drawable/ic_headphones"
                                android:tint="@color/text" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/pct_bt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:visibility="invisible" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/bar_progress" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Previous"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="@color/text" />

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_play"
                    android:contentDescription="Play or pause"
                    android:padding="10dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/on_accent" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Next"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/text" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
