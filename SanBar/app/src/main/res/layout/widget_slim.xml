<?xml version="1.0" encoding="utf-8"?>
<!--
    1-row full-width bar.
    Layers: RGB effect (fx_layer) → 2dp inset glass (content) → spectrum bars (viz_row) → controls.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root"
    android:clipToOutline="true">

    <include layout="@layout/fx_layer" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/bg_glass">

        <include layout="@layout/viz_bars" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/music_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cover"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cover_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Nothing playing"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Previous"
                    android:padding="5dp"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="@color/text" />

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_play"
                    android:contentDescription="Play or pause"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/on_accent" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Next"
                    android:padding="5dp"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/text" />

                <ImageView
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@color/divider"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:id="@+id/battery_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <ProgressBar
                            android:id="@+id/ring_phone"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:maxWidth="36dp"
                            android:maxHeight="36dp"
                            android:minWidth="36dp"
                            android:minHeight="36dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/ring_progress" />

                        <ProgressBar
                            android:id="@+id/ring_charge"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminate="true"
                            android:indeterminateBehavior="repeat"
                            android:indeterminateDrawable="@drawable/charge_comet"
                            android:indeterminateDuration="1600"
                            android:interpolator="@android:anim/linear_interpolator"
                            android:maxWidth="36dp"
                            android:maxHeight="36dp"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/ring_charge_fast"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminate="true"
                            android:indeterminateBehavior="repeat"
                            android:indeterminateDrawable="@drawable/charge_comet"
                            android:indeterminateDuration="600"
                            android:interpolator="@android:anim/linear_interpolator"
                            android:maxWidth="36dp"
                            android:maxHeight="36dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/icon_phone"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:contentDescription="Phone battery"
                                android:src="@drawable/ic_phone"
                                android:tint="@color/text" />

                            <TextView
                                android:id="@+id/pct_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:shadowColor="#CC000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                android:textColor="@color/text"
                                android:textSize="8.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/bt_group"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/ring_bt"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:maxWidth="36dp"
                            android:maxHeight="36dp"
                            android:minWidth="36dp"
                            android:minHeight="36dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/ring_progress" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/icon_bt"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:contentDescription="Headphone battery"
                                android:src="@drawable/ic_headphones"
                                android:tint="@color/text" />

                            <TextView
                                android:id="@+id/pct_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:shadowColor="#CC000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                android:textColor="@color/text"
                                android:textSize="8.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:indeterminate="false"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="0"
                android:progressDrawable="@drawable/bar_progress" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
