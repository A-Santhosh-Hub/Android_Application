<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fx_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/fx_spin"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/fx_spin"
        android:indeterminateDuration="3600"
        android:interpolator="@android:anim/linear_interpolator"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/fx_spin_fast"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/fx_spin"
        android:indeterminateDuration="1300"
        android:interpolator="@android:anim/linear_interpolator"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/fx_cycle"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/fx_cycle"
        android:indeterminateDuration="3000"
        android:interpolator="@android:anim/linear_interpolator"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/fx_cycle_fast"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/fx_cycle_fast"
        android:indeterminateDuration="3000"
        android:interpolator="@android:anim/linear_interpolator"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/fx_breathe"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/fx_breathe"
        android:indeterminateDuration="3000"
        android:interpolator="@android:anim/linear_interpolator"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/fx_breathe_fast"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/fx_breathe_fast"
        android:indeterminateDuration="3000"
        android:interpolator="@android:anim/linear_interpolator"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:visibility="gone" />
</FrameLayout>
